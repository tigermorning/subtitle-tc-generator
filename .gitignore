.venv/
__pycache__/
.omc/
bin/
obj/
node_modules/

*.fixed.srt
checker-report.txt

# 아이콘에 끌어다 놓다가 폴더로 떨어진 자막이 커밋되지 않게 한다.
tools/*.srt
tools/*.vtt

# 대용량 미디어는 저장소에 넣지 않는다. 자료 폴더의 영상은 로컬에만 둔다.
*.mp4
*.mkv
*.mov

# 영상·모델 실험용 임시 폴더
.tmp/

# 학습용 정답지 원본 폴더. 저작권 있는 영상·자막이라 저장소에 넣지 않는다(규칙 6).
# 대괄호는 gitignore에서 문자 클래스로 읽히므로 이스케이프한다.
\[습작\]*/

# 정답지에서 뽑은 자막(TC 포함)을 정리해 둔 폴더. 저작권 있는 정식 번역문이라
# 공개 저장소엔 안 올린다 — 로컬에만 두고, 백업은 별도 비공개 저장소로 한다.
학습한 TC 및 자막 모음/

# 모델 파일은 저장소에 넣지 않는다(용량). 없으면 도구가 어디서 받는지 알려 준다.
models/*.onnx
models/*.bin

# 실행 파일 빌드 결과와 딸려 오는 라이브러리(용량이 크다)
dist/
bin/*.dll
*.spec.bak
.msg  
.msg
.cmsg
