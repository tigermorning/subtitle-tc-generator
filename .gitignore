.venv/
__pycache__/
.omc/
bin/
obj/
node_modules/

*.fixed.srt
checker-report.txt

# 아이콘에 끌어다 놓다가 폴더로 떨어진 자막이 커밋되지 않게 한다.
tools/*.srt
tools/*.vtt

# 대용량 미디어는 저장소에 넣지 않는다. 자료 폴더의 영상은 로컬에만 둔다.
*.mp4
*.mkv
*.mov

# 영상·모델 실험용 임시 폴더
.tmp/

# 모델 파일은 저장소에 넣지 않는다(용량). 없으면 도구가 어디서 받는지 알려 준다.
models/*.onnx
models/*.bin

# 실행 파일 빌드 결과와 딸려 오는 라이브러리(용량이 크다)
dist/
bin/*.dll
*.spec.bak
