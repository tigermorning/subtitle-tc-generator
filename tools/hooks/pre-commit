#!/bin/sh
# 커밋 직전에 시험을 돌린다. 실패하면 커밋이 만들어지지 않는다.
#
# 왜 있나. CLAUDE.md 규칙 9("테스트가 0으로 끝날 때만 커밋한다")는 글로 적혀 있었고
# 그럼에도 세 번 뚫렸다. 파이프(| tail)가 종료 코드를 가리고, 세미콜론(;)이 실패를
# 넘겼다. 훅은 git이 돌리므로 명령을 어떻게 잇든 상관없다. 규칙이 글에서 기계로
# 넘어가는 자리가 여기다.
#
# 이 파일은 저장소에 들어 있다(.git/hooks/는 클론을 따라가지 않는다). 새 클론이나
# 워크트리에서 한 번 켠다:  git config core.hooksPath tools/hooks
#
# WSL과 Windows git-bash 양쪽에서 돈다. 파이썬 이름이 서로 달라서 찾아 쓴다.

ROOT=$(git rev-parse --show-toplevel) || exit 1
cd "$ROOT" || exit 1

PY=""
for candidate in python3 python py; do
    if command -v "$candidate" >/dev/null 2>&1 && "$candidate" -c "import sys" >/dev/null 2>&1; then
        PY="$candidate"
        break
    fi
done

if [ -z "$PY" ]; then
    echo "pre-commit: 파이썬을 찾지 못했다."
    echo "  시험을 못 돌리면 통과했다고 말할 수 없으므로 커밋을 막는다."
    echo "  정말 건너뛰려면: git commit --no-verify  (그러면 판단은 사람 몫이다)"
    exit 1
fi

echo "pre-commit: tests/run_tests.py"
TEST_LOG=$(mktemp)
if ! "$PY" tests/run_tests.py 2>&1 | tee "$TEST_LOG"; then
    echo ""
    echo "pre-commit: 시험이 실패했다. 커밋하지 않는다."
    rm -f "$TEST_LOG"
    exit 1
fi

# 파이프를 태웠으므로 종료 코드는 tee의 것이다. "전부 통과"를 직접 확인한다 —
# 규칙 9가 세 번 뚫린 이유가 정확히 이것(파이프가 종료 코드를 가린다)이다.
if ! grep -q "전부 통과" "$TEST_LOG"; then
    echo ""
    echo "pre-commit: 시험이 '전부 통과'로 끝나지 않았다. 커밋하지 않는다."
    rm -f "$TEST_LOG"
    exit 1
fi

# 문서가 코드보다 낡지 않게 함께 본다(2026-09-08). 규칙 17이 "손대기 전에 먼저
# 열어 보라"고 정한 파일이 낡으면 체크리스트가 오히려 함정이 된다 — 실제로
# HANDOFF 7절이 이미 끝난 일을 "다음 세션은 여기부터"로 붙들고 있었다.
COUNT=$(sed -n 's/^통과 \([0-9][0-9]*\)건$/\1/p' "$TEST_LOG" | tail -1)
rm -f "$TEST_LOG"

echo ""
echo "pre-commit: tools/docs_check.py"
if ! "$PY" tools/docs_check.py ${COUNT:+--test-count "$COUNT"}; then
    echo ""
    echo "pre-commit: 문서가 코드와 어긋난다. 커밋하지 않는다."
    echo "  시험 수만 어긋난 것이면 한 줄로 맞춘다:"
    echo "    $PY tools/docs_check.py --test-count $COUNT --fix-counts"
    echo "  지금은 맞는 표기인데 걸렸으면 그 줄에 \`docs-check: 무시\`를 남긴다."
    exit 1
fi

# 시스템 파이썬에는 PySide6가 없어 GUI 시험이 빠진다. 화면을 건드렸으면 사람이
# venv 쪽으로도 돌려야 한다. 막지는 않는다 — 훅이 특정 venv의 존재를 강제하면
# 다른 기계에서 커밋이 아예 안 된다. **여기에 시험 수를 적지 않는다** — 적는
# 순간 낡는다(그 숫자는 README와 CLAUDE.md에만 두고 docs_check가 지킨다).
if git diff --cached --name-only | grep -q '^app/'; then
    echo ""
    echo "pre-commit: app/ 을 건드렸다. PySide6까지 도는 시험은 훅이 못 돌린다:"
    echo "  cmd.exe /c \"..\\korean-subtitle-corrector\\.venv\\Scripts\\python.exe tests\\run_tests.py\""
fi

exit 0
